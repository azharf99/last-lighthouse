# ==============================================================================
# The Last Lighthouse — Environment Configuration (.env.example)
# Copy this file to .env before deploying: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Settings
# ------------------------------------------------------------------------------
# Server internal listening address (default inside Docker is :8080)
LLH_ADDR=:8080

# Turn timeout preset: "90s" (Realtime), "10m" (Relaxed), or "86400s" (24h Async)
LLH_TURN_TIMEOUT=90s

# Secret key for JWT Guest Token signing (Generate a secure random 32+ char string)
# Example generation command: openssl rand -hex 32
LLH_JWT_SECRET=super_secret_jwt_key_change_me_in_production_vps_deployment_123456

# Application Environment Mode (production / development)
NODE_ENV=production
GIN_MODE=release

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=lastlighthouse
POSTGRES_PASSWORD=secure_postgres_password_change_me
POSTGRES_DB=lastlighthouse
POSTGRES_PORT=5432

# Connection string used by the Go Backend Server
LLH_DB_URL=postgres://lastlighthouse:secure_postgres_password_change_me@postgres:5432/lastlighthouse?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Web & Nginx Reverse Proxy Ports
# ------------------------------------------------------------------------------
# External HTTP port exposed on the VPS
HTTP_PORT=80

# External HTTPS port exposed on the VPS (if using SSL termination)
HTTPS_PORT=443

# Domain name or VPS Public IP
DOMAIN_NAME=lastlighthouse.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Push Notifications (VAPID / Web Push / FCM - ADR-007)
# ------------------------------------------------------------------------------
# Optional: Predefined VAPID keys for Web Push. If empty, the server generates keys at boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Optional: Google Firebase Cloud Messaging (FCM) server key for mobile push
FCM_SERVER_KEY=
